    },
    {
      "parameters": {
        "jsCode": "// \u00e2\u201d\u20ac\u00e2\u201d\u20ac Story Input Validator \u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\n// Extracts and validates fields from the incoming webhook payload.\n\nconst body = $input.first().json.body || $input.first().json;\n\nconst system_prompt  = (body.system_prompt || '').trim();\nconst user_prompt    = (body.user_prompt || '').trim();\nconst preset_style   = (body.preset_style || 'cinematic').trim();\nconst story_category = (body.story_category || 'motivation').trim();\nconst duration       = parseInt(body.duration) || 45;\nconst language       = (body.language || 'english').trim();\nconst word_target    = parseInt(body.word_target) || Math.round(duration * 2.5);\n\n// Validate\nconst errors = [];\nif (!system_prompt) errors.push('system_prompt is required');\nif (!user_prompt)   errors.push('user_prompt is required');\nif (duration < 15 || duration > 180) errors.push('duration must be 15-180');\n\nif (errors.length > 0) {\n  return [{\n    json: {\n      valid: false,\n      error: errors.join('; '),\n      status: 400\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    valid: true,\n    system_prompt,\n    user_prompt,\n    preset_style,\n    story_category,\n    duration,\n    language,\n    word_target,\n    payload: {\n      system_prompt,\n      user_prompt,\n      preset_style,\n      story_category,\n      duration,\n      language,\n      word_target\n    }\n  }\n}];"
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "input_validator",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "version": 3,
