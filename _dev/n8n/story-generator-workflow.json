            {
              "message": "={{ $json.system_prompt }}"
            }
          ]
        },
        "batching": {}
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "LLM Chain",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        920,
        200
      ]
    },
    {
      "parameters": {
        "model": "google/gemini-2.5-flash",
        "options": {}
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Gemini via OpenRouter",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        920,
        420
      ],
      "credentials": {
        "openRouterApi": {
          "id": "mbWrJSQdMKz6Ve5M",
          "name": "OpenRouter account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// \u00e2\u201d\u20ac\u00e2\u201d\u20ac Story Output Validator \u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\u00e2\u201d\u20ac\n// Extracts the generated story text from the LLM chain output.\n\nconst item = $input.first().json;\n\n// The LLM chain returns the response in the 'text' field\nlet storyText = '';\n\nif (typeof item === 'string') {\n  storyText = item;\n} else if (item.text) {\n  storyText = item.text;\n} else if (item.response) {\n  storyText = item.response;\n} else if (item.output) {\n  storyText = item.output;\n} else {\n  // Try to find any string content\n  for (const [key, val] of Object.entries(item)) {\n    if (typeof val === 'string' && val.length > 50) {\n      storyText = val;\n      break;\n    }\n  }\n}\n\nstoryText = storyText.trim();\n\nif (!storyText) {\n  return [{\n    json: {\n      error: 'LLM returned no story text',\n      raw: JSON.stringify(item).slice(0, 500)\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    story_text: storyText\n  }\n}];"
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "output_validator",
      "type": "n8n-nodes-base.code",
