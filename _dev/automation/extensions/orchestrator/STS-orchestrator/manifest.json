{
  "manifest_version": 3,
  "name": "STS Orchestrator",
  "version": "1.0.0",
  "description": "ScriptToScene Studio — central controller for all STS extensions. Activates and focuses tabs.",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://localhost:* ws://127.0.0.1:*"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "STS Orchestrator"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
