{
  "manifest_version": 3,
  "name": "STS Grok Sync",
  "version": "1.0.0",
  "description": "ScriptToScene Studio — in-page Grok asset synchronizer",
  "permissions": ["storage"],
  "host_permissions": ["*://grok.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://localhost:* ws://127.0.0.1:*"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://grok.com/*"],
      "js": ["src/content.js"],
      "css": ["src/panel.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "STS Grok Sync"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
