{
  "name": "Storyboard Image Generator",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "storyboard-generator",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [400, 300],
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Webhook"
    },
    {
      "parameters": {
        "jsCode": "// ── Input Validator ─────────────────────────────────────────────\n// Validates the incoming webhook payload and builds the full WaveSpeed\n// API payload with generation parameters.\n// Supports style chaining: seed, image (reference URL), strength\n\nconst body = $input.first().json.body || $input.first().json;\nconst image_prompt = (body.image_prompt || '').trim();\nconst wavespeed_api_key = (body.wavespeed_api_key || '').trim();\nconst aspect_ratio = (body.aspect_ratio || '9:16').trim();\nconst project_id = body.project_id || null;\nconst scene = body.scene ?? null;\nconst seed = body.seed ?? -1;\nconst ref_image = (body.image || '').trim();\nconst strength = body.strength ?? 0.8;\n\nif (!image_prompt) {\n  return [{ json: { valid: false, error: 'Missing or empty \"image_prompt\"' } }];\n}\nif (!wavespeed_api_key) {\n  return [{ json: { valid: false, error: 'Missing or empty \"wavespeed_api_key\"' } }];\n}\n\nconst sizeMap = {\n  '9:16': '576*1024', '16:9': '1024*576', '1:1': '1024*1024',\n  '4:3': '1024*768', '3:4': '768*1024', '3:2': '1024*683', '2:3': '683*1024'\n};\nconst size = sizeMap[aspect_ratio] || '576*1024';\n\nreturn [{\n  json: {\n    valid: true,\n    error: null,\n    project_id,\n    scene,\n    wavespeed_api_key,\n    wavespeed_payload: {\n      enable_base64_output: false,\n      guidance_scale: 3.5,\n      image: ref_image,\n      loras: [],\n      num_images: 1,\n      num_inference_steps: 28,\n      output_format: 'jpeg',\n      prompt: image_prompt.replace(/\\n/g, '\\\\n'),\n      seed: seed,\n      size: size,\n      strength: strength\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [620, 300],
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "input_validator"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "version": 3,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "val-check-001",
              "leftValue": "={{ $json.valid }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [840, 300],
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "If"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.wavespeed.ai/api/v3/wavespeed-ai/flux-dev-lora-ultra-fast",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.wavespeed_api_key }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.wavespeed_payload) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1060, 200],
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Generate Image"
    },
    {
      "parameters": {
        "amount": 20
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1280, 200],
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Wait"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.wavespeed.ai/api/v3/predictions/{{ $('Generate Image').item.json.data.id }}/result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('input_validator').item.json.wavespeed_api_key }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1500, 200],
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Get Result"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "status-check-001",
              "leftValue": "={{ $json.data.status }}",
              "rightValue": "completed",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [1720, 200],
      "id": "a1b2c3d4-0008-4000-8000-000000000008",
      "name": "Is Completed"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "img-url-001",
              "name": "image_url",
              "value": "={{ $json.data.outputs[0] }}",
              "type": "string"
            },
            {
              "id": "proj-id-001",
              "name": "project_id",
              "value": "={{ $('input_validator').item.json.project_id }}",
              "type": "string"
            },
            {
              "id": "scene-001",
              "name": "scene",
              "value": "={{ $('input_validator').item.json.scene }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1940, 100],
      "id": "a1b2c3d4-0009-4000-8000-000000000009",
      "name": "Extract URL"
    },
    {
      "parameters": {
        "respondWith": "allIncomingItems",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [2160, 300],
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Respond to Webhook"
    }
  ],
  "connections": {
