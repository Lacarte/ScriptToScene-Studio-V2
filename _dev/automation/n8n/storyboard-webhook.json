      "parameters": {
        "jsCode": "// ── Input Validator ─────────────────────────────────────────────\n// Validates the incoming webhook payload for storyboard image generation.\n// Expects: { image_prompt: string, aspect_ratio?: string }\n\nconst body = $input.first().json.body || $input.first().json;\n\nconst image_prompt = (body.image_prompt || '').trim();\nconst aspect_ratio = (body.aspect_ratio || '16:9').trim();\n\n// ── Validate required fields ────────────────────────────────────\nif (!image_prompt) {\n  return [{\n    json: {\n      valid: false,\n      error: 'Missing or empty \"image_prompt\"',\n      image_prompt: null,\n      image_reference: null,\n      aspect_ration: null\n    }\n  }];\n}\n\n// ── Map aspect_ratio to WaveSpeed size format ───────────────────\n// The sub-workflow handles the actual API call; we just pass through.\n// Note: the sub-workflow field is \"aspect_ration\" (typo preserved).\n\nreturn [{\n  json: {\n    valid: true,\n    error: null,\n    image_prompt: image_prompt,\n    image_reference: null,\n    aspect_ration: aspect_ratio\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [620, 300],
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
